limit_req_zone $binary_remote_addr zone=lettrine_social:1m rate=10r/s;
limit_req_zone $binary_remote_addr zone=lettrine_registration:1m rate=6r/m;

server {
    listen 443 ssl;
    server_name amis.example.org;
    ssl_certificate /etc/letsencrypt/live/amis.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/amis.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 12k;
    limit_req_status 429;
    add_header Cache-Control "no-store" always;

    location ~ ^/api/social/(session|google(?:/challenge)?)$ {
        limit_req zone=lettrine_registration burst=5 nodelay;
        proxy_pass http://127.0.0.1:8790;
    }

    location /api/social/ {
        limit_req zone=lettrine_social burst=20 nodelay;
        proxy_pass http://127.0.0.1:8790;
    }

    location / { return 404; }
}
